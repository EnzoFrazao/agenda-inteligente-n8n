# Copie para .env (que está no .gitignore) e preencha localmente. Nunca versione o .env.

# Usado pelo docker compose: gere um valor aleatório longo.
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=America/Fortaleza

# Usados somente por `python -m avaliacao.avaliar --modo gemini`.
# No workflow, a chave do Gemini fica na credencial Header Auth do n8n.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

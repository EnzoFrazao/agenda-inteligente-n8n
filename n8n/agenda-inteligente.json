    {
      "id": "02",
      "name": "Normalizar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1160,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first();\nconst binarios = item.binary ?? {};\nconst nomes = Object.keys(binarios);\nif (nomes.length !== 1) throw new Error('A PoC exige exatamente um cartaz por e-mail.');\nconst remetente = item.json.from?.value?.[0]?.address ?? item.json.from ?? item.json.sender ?? '';\nconst messageId = item.json.id ?? item.json.messageId ?? item.json.message_id;\nif (!messageId) throw new Error('Gmail não forneceu message_id.');\nreturn [{json: {message_id: String(messageId), remetente: String(remetente), assunto: item.json.subject ?? '', corpo: item.json.text ?? item.json.textPlain ?? item.json.snippet ?? '', anexo_nome: nomes[0]}, binary: binarios}];"
      }
    },

      "name": "Detectar choque",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const atual = $input.first().json;\nconst linhas = $('Ler agenda').all().map((item) => item.json).filter((linha) => linha.message_id);\nconst ativos = new Set(['aprovado','conflito']);\nconst sobrepoe = (a, b) => Date.parse(a.inicio_iso) < Date.parse(b.fim_iso) && Date.parse(b.inicio_iso) < Date.parse(a.fim_iso);\nconst conflitos = linhas.filter((linha) => linha.message_id !== atual.message_id && ativos.has(linha.status) && linha.inicio_iso && linha.fim_iso && sobrepoe(atual.evento, linha));\nreturn [{json: {...atual, choque: conflitos.length > 0, conflitos: conflitos.map((item) => ({message_id: item.message_id, titulo: item.titulo, inicio_iso: item.inicio_iso, fim_iso: item.fim_iso}))}}];"
      }

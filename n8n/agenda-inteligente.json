      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const original = $('Normalizar mensagem').first();\nconst atual = original.json;\nconst linhas = $input.all().map((item) => item.json).filter((linha) => linha.message_id);\nconst existente = linhas.find((linha) => String(linha.message_id ?? '') === atual.message_id) ?? null;\nreturn [{json: {...atual, duplicado: existente !== null, registro_existente: existente}, binary: original.binary}];"
      }
    },
